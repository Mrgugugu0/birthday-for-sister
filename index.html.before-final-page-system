</section><section class="signature-section reveal">
    <div class="signature-line"></div>

    <p class="signature">
        杨杨
    </p>

    <p class="signature-date">
        送给玉姐
    </p>
</section>

<div class="page-nav" id="pageNav">
    <button id="prevPage" type="button">‹ 上一页</button>

    <div class="page-number" id="pageNumber">
        01 / 12
    </div>

    <button id="nextPage" type="button">下一页 ›</button>
</div>

<script>
const musicButton = document.getElementById("musicButton");
const bgMusic = document.getElementById("bgMusic");

musicButton.addEventListener("click", () => {
    if (bgMusic.paused) {
        bgMusic.play().then(() => {
            musicButton.textContent = "Ⅱ";
        }).catch(() => {});
    } else {
        bgMusic.pause();
        musicButton.textContent = "♪";
    }
});

const giftButton = document.getElementById("giftButton");

giftButton.addEventListener("click", () => {
    document.body.classList.add("gift-open");

    bgMusic.volume = 0.35;

    bgMusic.play().then(() => {
        musicButton.textContent = "Ⅱ";
    }).catch(() => {
        musicButton.textContent = "♪";
    });
});
const reveals = document.querySelectorAll(".reveal");

const observer = new IntersectionObserver(
    entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("visible");
            }
        });
    },
    {
        threshold: 0.12
    }
);

reveals.forEach(item => observer.observe(item));
const storyPages = Array.from(
    document.querySelectorAll("body > section:not(.hero)")
);

const prevPage = document.getElementById("prevPage");
const nextPage = document.getElementById("nextPage");
const pageNumber = document.getElementById("pageNumber");

let currentPage = 0;

function showPage(index, direction = 1) {
    if (index < 0 || index >= storyPages.length) {
        return;
    }

    const oldPage = storyPages[currentPage];
    const newPage = storyPages[index];

    if (oldPage === newPage) {
        pageNumber.textContent =
            String(currentPage + 1).padStart(2, "0") +
            " / " +
            String(storyPages.length).padStart(2, "0");

        prevPage.disabled = currentPage === 0;
        nextPage.disabled = currentPage === storyPages.length - 1;
        return;
    }

    /*
     * 真正的翻页：
     *
     * 旧页面先保持可见
     * 新页面同时出现，并从左/右侧进入
     * 动画完成后才隐藏旧页面
     */

    const enterFromRight = direction >= 0;

    // 旧页面继续留在屏幕下面
    oldPage.classList.add("story-page");
    oldPage.classList.add("page-active");

    oldPage.style.setProperty("display", "flex", "important");
    oldPage.style.setProperty("visibility", "visible", "important");
    oldPage.style.setProperty("opacity", "1", "important");
    oldPage.style.setProperty("z-index", "1", "important");
    oldPage.style.setProperty("transform", "translateX(0)", "important");

    // 新页面同时出现，在旧页面上面
    newPage.classList.add("story-page");
    newPage.classList.add("page-active");

    newPage.style.setProperty("display", "flex", "important");
    newPage.style.setProperty("visibility", "visible", "important");
    newPage.style.setProperty("opacity", "1", "important");
    newPage.style.setProperty("z-index", "2", "important");

    // 先把新页面放到屏幕外
    newPage.style.setProperty(
        "transform",
        enterFromRight
            ? "translateX(100vw)"
            : "translateX(-100vw)",
        "important"
    );

    // 清掉旧的动画类
    newPage.classList.remove(
        "page-from-right",
        "page-from-left",
        "page-turn-in-right",
        "page-turn-in-left",
        "page-turn-old"
    );

    // 强制浏览器完成“新页面在屏幕外”的这一帧
    void newPage.offsetWidth;

    // 开始真正的滑入
    newPage.style.setProperty(
        "transition",
        "transform 680ms cubic-bezier(.22,.61,.36,1)",
        "important"
    );

    requestAnimationFrame(() => {
        newPage.style.setProperty(
            "transform",
            "translateX(0)",
            "important"
        );
    });

    const finishTurn = () => {
        // 动画结束：新页面成为唯一页面
        oldPage.classList.remove("page-active");

        // 旧页面彻底退场，不再参与布局和点击
        oldPage.style.setProperty("display", "none", "important");
        oldPage.style.setProperty("visibility", "hidden", "important");
        oldPage.style.setProperty("pointer-events", "none", "important");
        oldPage.style.setProperty("opacity", "0", "important");
        oldPage.style.setProperty("z-index", "0", "important");
        oldPage.style.removeProperty("transform");
        oldPage.style.removeProperty("transition");

        // 新页面成为唯一可见页面
        newPage.style.setProperty("display", "flex", "important");
        newPage.style.setProperty("visibility", "visible", "important");
        newPage.style.setProperty("pointer-events", "auto", "important");
        newPage.style.setProperty("opacity", "1", "important");
        newPage.style.setProperty("z-index", "1", "important");
        newPage.style.removeProperty("transition");
        newPage.style.removeProperty("transform");

        currentPage = index;

        pageNumber.textContent =
            String(currentPage + 1).padStart(2, "0") +
            " / " +
            String(storyPages.length).padStart(2, "0");

        prevPage.disabled = currentPage === 0;
        nextPage.disabled = currentPage === storyPages.length - 1;
    };

    setTimeout(finishTurn, 700);
}

prevPage.addEventListener("click", () => {
    if (currentPage > 0) {
        showPage(currentPage - 1, -1);
    }
});

nextPage.addEventListener("click", () => {
    if (currentPage < storyPages.length - 1) {
        showPage(currentPage + 1, 1);
    }
});

showPage(0);

let touchStartX = 0;
let touchStartY = 0;

document.addEventListener("touchstart", event => {
    if (!document.body.classList.contains("gift-open")) {
        return;
    }

    if (event.touches.length !== 1) {
        return;
    }

    touchStartX = event.touches[0].clientX;
    touchStartY = event.touches[0].clientY;
}, { passive: true });

document.addEventListener("touchend", event => {
    if (!document.body.classList.contains("gift-open")) {
        return;
    }

    if (!touchStartX) {
        return;
    }

    const touchEndX = event.changedTouches[0].clientX;
    const touchEndY = event.changedTouches[0].clientY;

    const dx = touchEndX - touchStartX;
    const dy = touchEndY - touchStartY;

    touchStartX = 0;
    touchStartY = 0;

    // 只有明显的横向滑动才翻页
    if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy) * 1.2) {
        return;
    }

    if (dx < 0) {
        showPage(currentPage + 1, 1);
    } else {
        showPage(currentPage - 1, -1);
    }
}, { passive: true });
</script>

</body>
</html>
