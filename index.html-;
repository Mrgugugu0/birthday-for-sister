<title>给玉姐的一小段时光</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Playfair+Display:ital,wght@400;500;600&display=swap');

:root {
    --paper: #f4efe7;
    --ink: #332c27;
    --soft: #8d8177;
    --line: rgba(51,44,39,.18);
    --accent: #8c554b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--paper);
    color: var(--ink);
    font-family: "Noto Serif SC", serif;
    overflow-x: hidden;
}

/* 胶片颗粒 */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .055;
    z-index: 999;
    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
}

/* 顶部小标签 */
.chapter {
    font-family: "Playfair Display", serif;
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--soft);
    text-transform: uppercase;
}

/* =========================
   开场
========================= */

.hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 25px;
    position: relative;
}

.hero .tiny {
    font-size: 12px;
    letter-spacing: 5px;
    color: var(--soft);
    margin-bottom: 35px;
}

.hero h1 {
    font-family: "Playfair Display", "Noto Serif SC", serif;
    font-weight: 400;
    font-size: clamp(42px, 12vw, 75px);
    letter-spacing: 3px;
    line-height: 1.25;
}

.hero h1 span {
    display: block;
    font-family: "Noto Serif SC", serif;
    font-size: .48em;
    letter-spacing: 9px;
    margin-top: 15px;
}

.hero .intro {
    margin-top: 35px;
    color: var(--soft);
    font-size: 14px;
    line-height: 2.2;
}

.scroll {
    position: absolute;
    bottom: 30px;
    font-family: "Playfair Display", serif;
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--soft);
    animation: breathe 2.5s infinite;
}

.scroll::after {
    content: "";
    display: block;
    width: 1px;
    height: 40px;
    background: var(--line);
    margin: 12px auto 0;
}

@keyframes breathe {
    0%,100% { opacity: .4; }
    50% { opacity: 1; }
}

/* =========================
   普通章节
========================= */

.chapter-intro {
    min-height: 55svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 28px;
}

.chapter-intro h2 {
    font-size: clamp(30px, 8vw, 50px);
    font-weight: 400;
    line-height: 1.5;
    margin-top: 20px;
}

.chapter-intro p {
    margin-top: 25px;
    color: var(--soft);
    line-height: 2.2;
    font-size: 15px;
}

/* =========================
   照片
========================= */

.memory {
    padding: 70px 20px 120px;
}

.photo-wrap {
    width: 100%;
    max-width: 600px;
    margin: auto;
}

.photo {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 75svh;
    background: #ddd;
}

.photo-caption {
    padding: 25px 8px 0;
}

.photo-number {
    font-family: "Playfair Display", serif;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--soft);
}

.photo-caption h3 {
    margin-top: 13px;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.7;
}

.photo-caption p {
    margin-top: 12px;
    color: var(--soft);
    font-size: 14px;
    line-height: 2.1;
}

/* 每张照片之间的空白 */
.memory + .memory {
    padding-top: 0;
}

/* =========================
   分隔文字
========================= */

.quote {
    min-height: 70svh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px 35px;
    text-align: center;
}

.quote p {
    font-size: clamp(22px, 6vw, 34px);
    line-height: 2;
    font-weight: 300;
}

.quote small {
    display: block;
    margin-top: 30px;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--soft);
}

/* =========================
   信
========================= */

.letter {
    min-height: 100svh;
    padding: 100px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.letter-card {
    max-width: 600px;
    margin: auto;
}

.letter-title {
    font-family: "Playfair Display", serif;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--soft);
}

.letter h2 {
    font-size: 32px;
    font-weight: 400;
    margin-top: 25px;
}

.letter-content {
    margin-top: 45px;
    font-size: 16px;
    line-height: 2.5;
}

.signature {
    margin-top: 50px;
    text-align: right;
    font-family: "Playfair Display", serif;
    font-size: 15px;
}

/* =========================
   最终生日页
========================= */

.final {
    min-height: 100svh;
    background: #211d1a;
    color: #eee7dd;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 35px;
}

.final .small {
    font-family: "Playfair Display", serif;
    letter-spacing: 5px;
    font-size: 12px;
    opacity: .65;
}

.final h2 {
    font-family: "Playfair Display", "Noto Serif SC", serif;
    font-size: clamp(42px, 12vw, 70px);
    font-weight: 400;
    margin-top: 30px;
}

.final h3 {
    font-size: 25px;
    font-weight: 400;
    margin-top: 15px;
}

.final p {
    margin-top: 35px;
    line-height: 2.3;
    font-size: 14px;
    color: #c8beb4;
}

.final .heart {
    margin-top: 45px;
    font-size: 25px;
}

@keyframes heartbeat {
    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.15);
    }
}

/* 音乐按钮 */

.music-button {
    position: fixed;
    right: 18px;
    top: 18px;
    z-index: 1000;

    width: 42px;
    height: 42px;

    border-radius: 50%;
    border: 1px solid rgba(51,44,39,.2);

    background: rgba(244,239,231,.8);

    color: var(--ink);
    font-size: 16px;
}

/* 滚动出现 */

.reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
        opacity 1.1s ease,
        transform 1.1s cubic-bezier(.22, .61, .36, 1);
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}/* 手机适配 */

@media (max-width: 420px) {

    .hero h1 {
        font-size: 42px;
    }

    .chapter-intro {
