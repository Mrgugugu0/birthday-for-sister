<script>
const giftButton = document.getElementById("giftButton");

giftButton.addEventListener("click", () => {
    document.body.classList.add("gift-open");
});
const reveals = document.querySelectorAll(".reveal");

const observer = new IntersectionObserver(
    entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("visible");
            }
        });
    },
    {
        threshold: 0.12
    }
);

reveals.forEach(item => observer.observe(item));
const storyPages = Array.from(
    document.querySelectorAll("body > section:not(.hero)")
);

const prevPage = document.getElementById("prevPage");
const nextPage = document.getElementById("nextPage");
const pageNumber = document.getElementById("pageNumber");

let currentPage = 0;

function showPage(index) {
    if (index < 0 || index >= storyPages.length) {
        return;
    }

    storyPages.forEach((page, i) => {
        page.classList.toggle("story-page", true);
        page.classList.toggle("page-active", i === index);
    });

    currentPage = index;

    pageNumber.textContent =
        String(currentPage + 1).padStart(2, "0") +
        " / " +
        String(storyPages.length).padStart(2, "0");

    prevPage.disabled = currentPage === 0;
    nextPage.disabled = currentPage === storyPages.length - 1;
}

prevPage.addEventListener("click", () => {
    showPage(currentPage - 1);
});

nextPage.addEventListener("click", () => {
    showPage(currentPage + 1);
});

showPage(0);
</script>

