}
body:not(.gift-open) section:not(.hero) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

body.gift-open section:not(.hero) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
        opacity 1.2s ease,
        transform 1.2s ease;
}
}

